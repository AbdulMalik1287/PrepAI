GROQ_API_KEY=
# Any init_chat_model string, e.g. openai:gpt-5-mini or anthropic:claude-sonnet-5 (install that provider's langchain package)
LLM_MODEL=groq:openai/gpt-oss-120b
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=canopylabs/orpheus-v1-english
# Orpheus voices include troy, austin, hannah
TTS_VOICE=troy
